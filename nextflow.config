/*
 * TNBC scRNA-seq ML GenAI
 * Nextflow configuration
 */

nextflow.enable.dsl=2

/*
 * Default execution settings
 */
process {
    executor = 'local'
    cpus = 2
    memory = '4 GB'
    time = '2h'

    /*
     * Docker is enabled for all processes.
     * Individual processes can override the container image.
     */
    withLabel: docker {
        container = 'ubuntu:24.04'
    }
}

/*
 * Docker execution
 */
docker {
    enabled = true
    runOptions = '-u $(id -u):$(id -g)'
}

/*
 * Local profile
 */
profiles {

    local {
        process.executor = 'local'
    }

    docker {
        docker.enabled = true
    }
}

/*
 * Project parameters
 */
params {
    project_name = 'TNBC-scRNAseq-ML-GenAI'
    version = '0.1.0'
}
